# App
APP_ENV=dev

# Databases
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/servforce_material_workbench
STANDARD_LIBRARY_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/octopus_standard_library

# Object storage
STORAGE_BACKEND=minio
OBJECT_STORE_ENDPOINT=http://10.0.0.20:9000
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin
OBJECT_STORE_BUCKET=servforce-materials
OBJECT_STORE_STANDARD_BUCKET=servforce-standards
STANDARD_LIBRARY_OBJECT_STORE_BUCKET=octopus-standard-library
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_SECURE=false

# Model service
MODEL_API_KEY=
MODEL_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Text model for standard materialization
QWEN_TEXT_MODEL=qwen3.7-plus
QWEN_TEXT_TEMPERATURE=0.1
QWEN_TEXT_TOP_P=0.8
QWEN_TEXT_MAX_TOKENS=24000
QWEN_STANDARD_BODY_MAX_TOKENS=96000
QWEN_STANDARD_STRUCTURE_MAX_TOKENS=32000
QWEN_STANDARD_LOGIC_MAX_TOKENS=32000
QWEN_STANDARD_OVERVIEW_MAX_TOKENS=16000
QWEN_TEXT_TIMEOUT_SECONDS=1800
QWEN_TEXT_MAX_INPUT_CHARS=600000
QWEN_TEXT_FILE_UPLOAD_PURPOSE=file-extract

# Standard search
STANDARD_EMBEDDING_MODEL=text-embedding-v4
STANDARD_EMBEDDING_DIMENSIONS=1024
STANDARD_EMBEDDING_TIMEOUT_SECONDS=120
STANDARD_VECTOR_SEARCH_MIN_SCORE=0
STANDARD_SEARCH_RESULT_LIMIT=5

# Standard work
STANDARD_WORKDIR=./work/standards

# OpenSTD importer
OPENSTD_IMPORTER_TOOL_DIR=./tools/openstd-importer
OPENSTD_OBJECT_STORE_BUCKET=openstd
OPENSTD_SOURCE_URL=https://openstd.samr.gov.cn/bzgk/std/
OPENSTD_CRAWL_SCOPE=all_national_standards
OPENSTD_ALLOWED_STATUSES=现行,即将实施
OPENSTD_REQUEST_INTERVAL_SECONDS=6
OPENSTD_MAX_RETRIES=2
OPENSTD_MAX_PAGES=1
OPENSTD_MAX_ITEMS=0
OPENSTD_DOWNLOAD_TIMEOUT_SECONDS=180

# Standard collector
STANDARD_COLLECTOR_REQUEST_INTERVAL_SECONDS=6
STANDARD_COLLECTOR_MAX_RETRIES=2
STANDARD_COLLECTOR_RETRY_BACKOFF_SECONDS=3
STANDARD_COLLECTOR_DISCOVER_TIMEOUT_SECONDS=0
STANDARD_COLLECTOR_LOG_FILE=./tools/standard-collector/logs/collect_national_pdfs.log

# Standard update scheduler
STANDARD_UPDATE_INTERVAL_SECONDS=1800
STANDARD_UPDATE_NATIONAL_ENABLED=true
STANDARD_UPDATE_INDUSTRY_ENABLED=false
STANDARD_UPDATE_LOCAL_ENABLED=false
STANDARD_UPDATE_INDUSTRY_CATEGORIES=
STANDARD_UPDATE_LOCAL_CATEGORIES=
STANDARD_UPDATE_SACINFO_REQUIRE_CATEGORIES=true
STANDARD_UPDATE_SACINFO_STATUS=
STANDARD_UPDATE_SACINFO_PAGE_SIZE=50
STANDARD_UPDATE_SACINFO_MAX_PAGES=1
STANDARD_UPDATE_SACINFO_MAX_ITEMS=50
STANDARD_UPDATE_SACINFO_DOWNLOAD_PDFS=true
STANDARD_UPDATE_SACINFO_PROCESSING_LIMIT=0
STANDARD_UPDATE_SACINFO_REFRESH_ATLAS=true
STANDARD_UPDATE_REQUEST_INTERVAL_SECONDS=3
STANDARD_UPDATE_MAX_RETRIES=2
STANDARD_UPDATE_RETRY_BACKOFF_SECONDS=3
STANDARD_UPDATE_MAX_PAGES_SAFETY=0
STANDARD_UPDATE_KNOWN_PAGE_STOP_COUNT=2
STANDARD_UPDATE_CHECK_UPCOMING=true
STANDARD_UPDATE_UPCOMING_LIMIT=0
STANDARD_UPDATE_ACTIVE_CHECK_LIMIT=0
STANDARD_UPDATE_NEW_MATERIALIZE_LIMIT=0
STANDARD_UPDATE_LOG_FILE=./tools/standard-collector/logs/sync_national_updates.log
STANDARD_UPDATE_SCHEDULER_ENABLED=false

# Worker
STANDARD_LIBRARY_PROCESSING_WORKER_ENABLED=false
WORKER_POLL_INTERVAL_SECONDS=1
